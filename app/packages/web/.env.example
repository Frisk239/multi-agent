# 复制为 packages/web/.env.local（gitignore；勿提交密钥）
# cp .env.example .env.local
#
# API / WS 基址（默认本机 3001）
# NEXT_PUBLIC_API_URL=http://localhost:3001/api
# NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
#
# Slice 59：局域网 token Web 闭环（与 server MA_LOCAL_TOKEN 同值）
# - 仅 env；不落库；Settings 只读检测，无密钥表单
# - HTTP：自动 X-MA-Token；WS：自动 ?token=
# - loopback 日用可不设；局域网非 loopback 时服务端强制鉴权才需要
# NEXT_PUBLIC_MA_LOCAL_TOKEN=change-me
