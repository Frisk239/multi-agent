# 复制为同目录 .env 后填写（.env 已被 gitignore，勿提交）
# cp .env.example .env

# 工作区根目录（也可在 Settings UI 保存到 DB）
# MA_WORKSPACE_CWD=D:/code/multi-agent

# Slice 38：默认只绑 127.0.0.1。局域网暴露：
# MA_BIND=0.0.0.0
# （兼容 HOST；优先级 MA_BIND > HOST）
# 同时放宽 CORS（逗号分隔，或 * 反射任意 origin，不推荐）：
# MA_CORS_ORIGIN=http://192.168.1.10:3000,http://localhost:3000
# PORT=3001
#
# Slice 49：局域网 token（不落库、不进 Settings UI 存盘）
# 非 loopback 且已配置时：/api/* 与 /ws 必须带 token（/healthz 始终放行）
# 传递：Authorization: Bearer <token> 或 X-MA-Token: <token>；WS 用 ?token=
# MA_LOCAL_TOKEN=change-me
# 非 loopback 无 token 时拒绝启动（默认仅 warn 仍放行，兼容旧文档）：
# MA_LOCAL_TOKEN_REQUIRED=1
# 可选：loopback 也强制校验（便于本地测鉴权）：
# MA_LOCAL_TOKEN_ALWAYS=1
#
# Slice 59：Web 侧同值（packages/web/.env.local 的 NEXT_PUBLIC_MA_LOCAL_TOKEN）
# 浏览器会打包进前端；仅用于受控局域网，勿当公网密钥体系

# Wiki LLM（OpenAI Chat Completions 兼容）
WIKI_LLM_PROVIDER=openai
WIKI_LLM_API_KEY=
WIKI_LLM_BASE_URL=http://64.83.1.104:8317/v1
WIKI_LLM_MODEL=grok-4.5

# Slice 47：Wiki ingest running 墙钟 lease（默认 20min）。超时 → failCount++ + pending 退避；0=关闭
# MA_WIKI_RUNNING_LEASE_MS=1200000

# 可选：向量记忆
# MEMORY_PROVIDER=sqlite-text
# EMBEDDING_API_KEY=
# OPENAI_API_KEY=

# Slice 28：本地模型价表（USD/1M tokens）。无配置时 cost 全 uncosted，不兜底 $3/$15。
# 二选一：内联 JSON，或文件路径（示例见 model-rates.example.json）
# MA_MODEL_RATES_JSON={"models":{"claude-sonnet-4":{"promptUsdPer1M":3,"completionUsdPer1M":15}}}
# MA_MODEL_RATES_PATH=./model-rates.example.json
