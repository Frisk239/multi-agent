{
  "name": "multi-agent-app",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter=@ma/server --filter=@ma/web run dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm test"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "playwright": "^1.61.1",
    "vitest": "^4.1.10"
  }
}
